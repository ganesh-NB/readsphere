# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Using local MongoDB - make sure MongoDB is installed and running
MONGODB_URI=mongodb://localhost:27017/readsphere

# JWT Secret (change this to a random string in production)
JWT_SECRET=readsphere-secret-key-2024

# Session Secret (change this to a random string in production)
SESSION_SECRET=readsphere-session-secret-2024

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Google OAuth Configuration (optional - leave empty to disable Google login)
# To enable, get credentials from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
